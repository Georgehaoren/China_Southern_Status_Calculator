{
  "version": "2026-06-working-v17-sanitized-sources",
  "source_note": "非官方合作状态/风险工作库。用于避免把历史联盟/历史合作错误当作当前可累积；状态必须随南航公告、合作航司公告和实际入账持续更新。",
  "policy_notes_cn": [
    "南航2019年退出天合联盟时曾公告与多家天合成员继续双边常旅客合作；但2025-2026后公开页面/公告显示部分旧合作已调整、暂停或终止。本库将旧天合伙伴默认标记为需核验，不再默认自动累积。",
    "合作状态只用于本地测算和输入提示，不等同于实际入账保证；实际应以南航明珠最新合作伙伴页面、公告、客服确认和最终入账为准。",
    "代码共享合作与常旅客累积合作需要分开记录；即使代码共享仍存在，也不代表可累积南航定级里程/航段。"
  ],
  "status_definitions": {
    "active_ffp_partner": "当前可作为南航明珠合作伙伴累积的工作状态。",
    "active_limited_or_special": "当前可用但存在日期/航线/票号/舱位等限制。",
    "adjusted_or_expired": "公开表或公告显示已调整/到期；默认不自动计入2026以后计划。",
    "legacy_skyteam_verify_required": "南航退出天合后曾有双边合作，但当前公开状态不明确或可能已暂停/终止；默认不自动计入。",
    "codeshare_or_elite_only_unknown_ffp": "可能有代码共享/精英权益/其他合作，但常旅客累积未知；默认仅作为输入提示。",
    "self_or_subsidiary": "南航/重航体系内。"
  },
